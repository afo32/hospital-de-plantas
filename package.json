{
  "name": "hospital-de-plantas",
  "private": true,
  "version": "0.1.0",
  "description": "App de cuidado de plantas: monorepo con app Expo, API NestJS y tipos compartidos",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @hdp/shared",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "api:dev": "npm run start:dev -w api",
    "api:migrate": "npm run prisma:migrate -w api",
    "api:studio": "npm run prisma:studio -w api",
    "mobile": "npm run start -w mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
