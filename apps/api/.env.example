# Copia este archivo a .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# Postgres de docker-compose (npm run db:up). Puerto 5440 para no chocar con otros Postgres (5432, 5433…)
DATABASE_URL=postgresql://hdp:hdp@localhost:5440/hospital_plantas?schema=public

# Redis de docker-compose (se usa a partir de la fase 5)
REDIS_URL=redis://localhost:6379

# Secreto para firmar los tokens de sesión (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-acceso
# Minutos que dura el token de acceso y días que dura la sesión
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Inicio de sesión con Google: ID de cliente de tipo "Aplicación web" (termina en .apps.googleusercontent.com)
GOOGLE_WEB_CLIENT_ID=

# Inicio de sesión con Apple: desactivado hasta tener cuenta Apple Developer
FEATURE_APPLE_LOGIN=false

# Claves de APIs externas
# Pl@ntNet (identificación): https://my.plantnet.org → tu cuenta → API key
# Anthropic (fichas y diagnóstico de salud): https://console.anthropic.com
PLANTNET_API_KEY=
ANTHROPIC_API_KEY=
# Modelo de Claude para fichas y diagnóstico
ANTHROPIC_MODEL=claude-sonnet-5-5
# Límites por usuario y día
IDENTIFY_DAILY_LIMIT=10
DIAGNOSE_DAILY_LIMIT=3

# Fotos (fase 6) en Cloudflare R2: mira docs/fotos-r2.md.
# Si lo dejas vacío, las fotos se guardan en la carpeta UPLOADS_DIR del servidor (vale para probar en tu PC).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hospital-de-plantas
UPLOADS_DIR=uploads

# Avisos push del jardín compartido (fase 7): segundos que se esperan para juntar acciones en un aviso
PUSH_BATCH_SECONDS=60
# Solo si activas "Enhanced security for push notifications" en expo.dev
EXPO_ACCESS_TOKEN=
# Email de contacto que sale en /v1/privacidad y /v1/borrar-cuenta
SUPPORT_EMAIL=
# URL pública del API sin /v1 (en Railway: https://TU-DOMINIO). Hace que los enlaces de invitación se puedan pulsar
PUBLIC_URL=
