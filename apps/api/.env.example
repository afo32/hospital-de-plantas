# Copia este archivo a .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# Postgres de docker-compose (npm run db:up). Puerto 5440 para no chocar con otros Postgres (5432, 5433…)
DATABASE_URL=postgresql://hdp:hdp@localhost:5440/hospital_plantas?schema=public

# Redis de docker-compose (se usa a partir de la fase 5)
REDIS_URL=redis://localhost:6379

# Secreto para firmar los tokens de sesión (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-acceso
# Minutos que dura el token de acceso y días que dura la sesión
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Inicio de sesión con Google: ID de cliente de tipo "Aplicación web" (termina en .apps.googleusercontent.com)
GOOGLE_WEB_CLIENT_ID=

# Inicio de sesión con Apple: desactivado hasta tener cuenta Apple Developer
FEATURE_APPLE_LOGIN=false

# Claves de APIs externas (se rellenan en fases 3, 5 y 6)
PLANTNET_API_KEY=
KINDWISE_API_KEY=
ANTHROPIC_API_KEY=
