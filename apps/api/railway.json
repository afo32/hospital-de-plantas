{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @hdp/shared && npm run build -w api"
  },
  "deploy": {
    "preDeployCommand": "npm run prisma:deploy -w api",
    "startCommand": "npm run start:prod -w api",
    "healthcheckPath": "/v1/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
