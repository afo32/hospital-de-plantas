# Copia este archivo a .env
# URL del API. En el móvil físico NO sirve "localhost": usa la IP de tu ordenador en la wifi,
# por ejemplo http://192.168.0.22:3000/v1  (en Windows: ipconfig → bloque Wi-Fi → Dirección IPv4)
# En el emulador de Android usa http://10.0.2.2:3000/v1
EXPO_PUBLIC_API_URL=http://192.168.0.22:3000/v1

# ID de cliente OAuth de Google de tipo "Aplicación web" (el mismo que GOOGLE_WEB_CLIENT_ID del API)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Ajustes de TU ordenador (como REACT_NATIVE_PACKAGER_HOSTNAME) van en .env.local, no aquí.
