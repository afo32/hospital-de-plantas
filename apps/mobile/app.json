{
  "expo": {
    "name": "Hospital de Plantas",
    "slug": "hospital-de-plantas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hospitaldeplantas",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.hospitaldeplantas.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4ECD8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hospitaldeplantas.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4ECD8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hospital de Plantas usa la cámara para identificar tus plantas y revisar su salud.",
          "photosPermission": "Hospital de Plantas usa tus fotos para identificar plantas y guardarlas en tus notas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hospital de Plantas usa tu ubicación aproximada para saber el tiempo de tu zona y si tus plantas pueden estar fuera."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F6B3A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7b11d7f0-2f14-49d7-852c-798cd5155ef9"
      }
    },
    "owner": "afo32"
  }
}
