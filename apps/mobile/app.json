{
  "expo": {
    "name": "Hospital de Plantas",
    "slug": "hospital-de-plantas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hospitaldeplantas",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.hospitaldeplantas.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4ECD8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hospitaldeplantas.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4ECD8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hospital de Plantas usa la cámara para identificar tus plantas y revisar su salud.",
          "photosPermission": "Hospital de Plantas usa tus fotos para identificar plantas y guardarlas en tus notas.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
